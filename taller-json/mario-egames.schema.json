{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Cursa de Super Mario kart",
    "description": "Informació de la classificació final de la cursa al joc del Mario Cart",
    "type": "object",
    "properties": {
        "circuit":{
            "description": "Nombre del circuit que es juga",
            "type":"string",
            "enum": ["Prado Rosquilla", "Cataratas Yoshi", "Barranco Goloso", "Fábrica de Toad"]
        },
        "Classificació":{
            "description": " informació de la classificació al final de la cursa de cada participant",
            "type": "array",
            "items": {
                "type": "object",
                "minimum": 2,
                "maxItems": 20,
                "properties": {
                    "posició":{
                        "description": "Posició en la que ha quedat",
                        "type": "integer",  
                        "inclusiveMinimum": 1,
                        "inclusiveMaximum": 20
                    },
                    "nick-player":{
                        "description": "Nom del participant",
                        "type": "string"
                    },
                    "personatge":{
                        "description": "Personatge del joc utilitzat",
                        "type":"string"
                    },
                    "color":{
                        "description": "Color utilitzat",
                        "type": "string",
                        "enum": ["blanc","negre","groc","blau","roig","verd","taronja","lila","rosa"]
                    },
                    "Temps":{
                        "description": "Temps en finalitzar",
                        "type":"string",
                        "pattern": "^(?:[0-9]|[0-9]{2}):[0-5][0-9]$"
                    },
                    "voltes":{
                        "description": "Voltes que s'han fet",
                        "type":"integer",
                        "inclusiveMinimum": 0,
                        "inclusiveMaximum": 5
                    },
                    "Accidents":{
                        "description": "Nombnre d'Accidents que ha provocat",
                        "type":"integer"
                    },
                    "Nitros":{
                        "description": "Numero de Nitros que ha utilitzat",
                        "type":"integer"
                    },
                    "Rookie":{
                        "description": "Primer vegada que es participa?",
                        "type":"string",
                        "enum": ["Si","No"]
                    }

                },
                "required": ["posició", "nick-player","personatge", "Temps", "voltes","Accidents"]   
            }       
        }
    }
}